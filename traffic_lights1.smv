MODULE main
VAR
  major_light : {green, yellow, red};
  minor_light : {green, yellow, red};
  sensor : {on, off};
  car_arrival : {yes, no};

ASSIGN
  init(major_light) := green;
  init(minor_light) := red;
  init(sensor) := off;  
  init(car_arrival) := no;

  next(major_light) := case
    major_light = green & sensor = on & car_arrival = yes : yellow;
    major_light = yellow : red;  
    minor_light = red : green; 
    TRUE : major_light;
  esac;

  next(minor_light) := case 
    minor_light = red & major_light = red : green;  
    minor_light = green & major_light = red : yellow;
    minor_light = yellow : red;    
    TRUE : minor_light;
  esac;

  next(sensor) := case
    minor_light = red : on;
    car_arrival = yes : off ;
    TRUE : sensor;
  esac;

  next(car_arrival) := case
    car_arrival = no : yes;  
    TRUE : car_arrival;
  esac;

-- Propriétés

CTLSPEC AG (EF (major_light = red & minor_light = green)); 


CTLSPEC AG !(major_light = yellow & minor_light = yellow);

CTLSPEC AG (EF major_light = yellow); 
CTLSPEC AG (EF minor_light = yellow);

CTLSPEC AG (EF sensor = on); 
CTLSPEC AG (EF sensor = off);

CTLSPEC AG (sensor = on -> EF minor_light = green);  

CTLSPEC AG (car_arrival = yes -> EF sensor = on);

CTLSPEC A[major_light = green U (car_arrival = yes)]; 

CTLSPEC AG (major_light = green & car_arrival = yes & sensor = on -> AX major_light = yellow); 
CTLSPEC AG ((major_light = red | minor_light = red) -> AF(major_light = green | minor_light = green)); 

CTLSPEC AG (major_light = red -> AF minor_light = green);
CTLSPEC AG (major_light = yellow -> AF major_light != yellow);
CTLSPEC AG (minor_light = yellow -> AF minor_light != yellow);
CTLSPEC AG ((car_arrival = yes & minor_light = red) -> AF sensor = on); 

CTLSPEC AG (major_light = yellow -> AF major_light = red);



CTLSPEC AG (EF (major_light = green & minor_light = red)); 

CTLSPEC AG !(major_light = green & minor_light = green); 
CTLSPEC AG !(major_light = red & minor_light = red);

CTLSPEC AG (major_light = green -> minor_light = red);
CTLSPEC AG (minor_light = green -> major_light = red);



-- how to excute the model :
-- ./NuSMV traffic_lights1.smv
-- ou 
-- ./NuSMV -int : Lancer NuSMV en mode interactif
-- NuSMV > read_model -i traffic_lights1.smv : Charger le modèle
-- NuSMV > go : Construire le modèle
-- NuSMV > check_ctlspec -n 0 : Vérifier la propriété 
-- NuSMV > show_property : Affichez toutes les propriétés définies dans le modèle
-- NuSMV > check_ctlspec