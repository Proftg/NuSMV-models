MODULE main
VAR
  major_light : {green, yellow, red};
  minor_light : {green, yellow, red};
  sensor : {on, off};
  car_arrival : {waiting, not_waiting};
  timer_yellow : 0..5;

ASSIGN
  init(major_light) := green;
  init(minor_light) := red;
  init(sensor) := on;
  init(car_arrival) := not_waiting;
  init(timer_yellow) := 0;

  next(major_light) := case
    major_light = green & sensor = on & minor_light = red : yellow;
    major_light = yellow & timer_yellow > 5 : red;
    major_light = red & minor_light = yellow : green;
    TRUE : major_light;
  esac;

  next(minor_light) := case
    minor_light = red & sensor = on & major_light = yellow : green;
    minor_light = green : yellow;
    minor_light = yellow & timer_yellow >= 5 : red;
    TRUE : minor_light;
  esac;

  next(sensor) := case
    minor_light = red & car_arrival = waiting : on;
    minor_light != red : off;
    TRUE : off;
  esac;

  next(car_arrival) := {waiting, not_waiting};

  next(timer_yellow) := case
    (major_light = yellow | minor_light = yellow) & timer_yellow < 5 : timer_yellow + 1;
    TRUE : 0;
  esac;

-- Propriétés
CTLSPEC AG ((major_light = yellow | minor_light = yellow) -> timer_yellow <= 5); -- Durée du feu jaune
CTLSPEC AG !(major_light = green & minor_light = green); -- Pas de conflit
CTLSPEC AG !(major_light = red & minor_light = red); -- Pas tous rouges
CTLSPEC AG (minor_light != red -> EF sensor = off); -- Désactivation du capteur


-- how to excute the model :
-- ./NuSMV -int : Lancer NuSMV en mode interactif
-- NuSMV > read_model -i traffic_lights2-b.smv : Charger le modèle
-- NuSMV > go : Construire le modèle
-- NuSMV > check_ctlspec -n 0 : Vérifier la propriété 
-- NuSMV > show_property : Affichez toutes les propriétés définies dans le modèle
-- check_ctlspec