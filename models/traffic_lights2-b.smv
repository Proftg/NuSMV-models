MODULE main
VAR
  major_light : {green, yellow, red};
  minor_light : {green, yellow, red};
  sensor : {on, off};
  car_arrival : {waiting, not_waiting};
  timer : 0..5;

ASSIGN
  init(major_light) := green;
  init(minor_light) := red;
  init(sensor) := on;
  init(car_arrival) := not_waiting;
  init(timer) := 0;

  next(major_light) := case
    major_light = green & sensor = on : yellow;
    major_light = yellow & timer >= 5 : red;
    major_light = red & minor_light = yellow & timer >= 5 : green;
    TRUE : major_light;
  esac;

  next(minor_light) := case
    minor_light = red & major_light = yellow : green;  -- S'assurer que major_light est rouge avant de passer à vert
    minor_light = green & timer >= 5 : yellow;
    minor_light = yellow & timer >= 5 : red;
    TRUE : minor_light;
  esac;

  next(sensor) := case
    next(minor_light) = red & car_arrival = waiting : on;
    next(minor_light) != red : off;
    TRUE : off;
  esac;

  next(car_arrival) := {waiting, not_waiting};

  next(timer) := case
    (major_light = yellow | minor_light = yellow | minor_light = green) & timer < 5 : timer + 1;
    (major_light = yellow | minor_light = yellow | minor_light = green) & timer >= 5 & 
      (next(major_light) != major_light | next(minor_light) != minor_light) : 0;
    TRUE : timer;  -- Garder la valeur actuelle du timer par défaut
  esac;

-- Propriétés
CTLSPEC AG (EF (major_light = green & minor_light = red));
CTLSPEC AG (EF (major_light = red & minor_light = green));
CTLSPEC AG !(major_light = green & minor_light = green);
CTLSPEC AG !(major_light = red & minor_light = red);
CTLSPEC AG !(major_light = yellow & minor_light = yellow);
CTLSPEC AG (major_light = green -> minor_light = red);
CTLSPEC AG (EF major_light = yellow);
CTLSPEC AG (EF minor_light = yellow);
CTLSPEC AG (EF sensor = on);
CTLSPEC AG (EF sensor = off);
CTLSPEC AG (sensor = on -> EF minor_light = green);
CTLSPEC AG (car_arrival = waiting -> EF sensor = on);
CTLSPEC AG (minor_light != red -> sensor = off);
CTLSPEC AG (sensor = on -> minor_light = red);
CTLSPEC AG (major_light = yellow -> EF major_light != yellow);
CTLSPEC AG (minor_light = yellow -> EF minor_light != yellow);
CTLSPEC AG ((car_arrival = waiting & minor_light = red) -> EF sensor = on);

-- Propriétés liées au timer pour vérifier que les feux jaunes restent allumés pendant 5 unités de temps
CTLSPEC AG (timer <= 5); -- Le timer ne dépasse jamais 5
CTLSPEC AG (major_light = yellow -> EF (timer >= 5 & major_light = yellow)); -- Major yellow reste allumé jusqu'à timer >= 5
CTLSPEC AG (minor_light = yellow -> EF (timer >= 5 & minor_light = yellow)); -- Minor yellow reste allumé jusqu'à timer >= 5
CTLSPEC AG (major_light = yellow & timer >= 5 -> EF (major_light != yellow)); -- Major yellow change après timer >= 5
CTLSPEC AG (minor_light = yellow & timer >= 5 -> EF (minor_light != yellow)); -- Minor yellow change après timer >= 5


-- how to excute the model :
-- ./NuSMV traffic_lights2-b.smv
-- ./NuSMV -int : Lancer NuSMV en mode interactif
-- NuSMV > read_model -i traffic_lights2-b.smv : Charger le modèle
-- NuSMV > go : Construire le modèle
-- NuSMV > check_ctlspec -n 0 : Vérifier la propriété 
-- NuSMV > show_property : Affichez toutes les propriétés définies dans le modèle
-- check_ctlspec