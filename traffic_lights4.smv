MODULE main
VAR
  major_light : {green, yellow, red};
  minor_light : {green, yellow, red};
  sensor : {on, off};
  ped_light : {green, red};
  button : {pressed, not_pressed};
  timer_major : 0..30;
  timer_minor : 0..30;
  timer_yellow : 0..5;
  emergency_mode : boolean;

ASSIGN
  init(major_light) := green;
  init(minor_light) := red;
  init(sensor) := off;
  init(ped_light) := red;
  init(button) := not_pressed;
  init(timer_major) := 0;
  init(timer_minor) := 0;
  init(timer_yellow) := 0;
  init(emergency_mode) := FALSE;

  -- Transitions des feux principaux
  next(major_light) := case
    emergency_mode : green;  -- Priorité au feu principal en cas d'urgence
    major_light = green & sensor = on & timer_major >= 30 : yellow;
    major_light = yellow & timer_yellow >= 5 : red;
    major_light = red & timer_minor >= 30 : green;
    TRUE : major_light;
  esac;

  -- Transitions des feux secondaires
  next(minor_light) := case
    emergency_mode : red;  -- Toujours rouge en cas d'urgence
    minor_light = red & sensor = on & timer_major >= 30 : green;
    minor_light = green & timer_minor >= 30 : yellow;
    minor_light = yellow & timer_yellow >= 5 : red;
    TRUE : minor_light;
  esac;

  -- Mise à jour des compteurs
  next(timer_major) := case
    emergency_mode : 0;  -- Réinitialiser en cas d'urgence
    major_light = green & timer_major < 30 : timer_major + 1;
    major_light = green & timer_major = 30 : 30;
    TRUE : 0;
  esac;

  next(timer_minor) := case
    emergency_mode : 0;  -- Réinitialiser en cas d'urgence
    minor_light = green & timer_minor < 30 : timer_minor + 1;
    minor_light = green & timer_minor = 30 : 30;
    TRUE : 0;
  esac;

  next(timer_yellow) := case
    emergency_mode : 0;  -- Réinitialiser en cas d'urgence
    (major_light = yellow | minor_light = yellow) & timer_yellow < 5 : timer_yellow + 1;
    (major_light = yellow | minor_light = yellow) & timer_yellow = 5 : 5;
    TRUE : 0;
  esac;

  -- Capteur
  next(sensor) := case
    emergency_mode : off;  -- Désactivé en cas d'urgence
    minor_light = red & sensor = off : {on, off};
    minor_light != red : off;
    TRUE : sensor;
  esac;

  -- Bouton piéton
  next(button) := case
    emergency_mode : not_pressed;  -- Désactivé en cas d'urgence
    TRUE : {pressed, not_pressed};
  esac;

  -- Feux piétons
  next(ped_light) := case
    emergency_mode : red;  -- Toujours rouge en cas d'urgence
    minor_light = red & button = pressed : green;
    minor_light != red : red;
    TRUE : ped_light;
  esac;

  -- Mode d'urgence (peut être activé ou désactivé à tout moment)
  next(emergency_mode) := {TRUE, FALSE};

-- Propriétés de sécurité
CTLSPEC NAME safety_1 := AG !(major_light = green & minor_light = green);
CTLSPEC NAME safety_2 := AG !(major_light = green & ped_light = green);
CTLSPEC NAME safety_3 := AG !(minor_light = green & ped_light = green);

-- Propriétés de vivacité
CTLSPEC NAME liveness_1 := AG (button = pressed -> AF ped_light = green);
CTLSPEC NAME liveness_2 := AG (sensor = on -> AF minor_light = green);
CTLSPEC NAME liveness_3 := AG (major_light = red -> AF major_light = green);

-- Propriétés d'équité
CTLSPEC NAME fairness_1 := AG AF major_light = green;
CTLSPEC NAME fairness_2 := AG AF minor_light = green;
CTLSPEC NAME fairness_3 := AG (button = pressed -> AF ped_light = green);

-- Propriétés de consistance
CTLSPEC NAME consistency_1 := AG (ped_light = green -> major_light = red);
CTLSPEC NAME consistency_2 := AG (minor_light = green -> major_light = red);
CTLSPEC NAME consistency_3 := AG (major_light = yellow -> AX major_light = red);
CTLSPEC NAME consistency_4 := AG (minor_light = yellow -> AX minor_light = red);

-- Propriétés de séquencement
CTLSPEC NAME sequence_1 := AG (major_light = green -> A[major_light = green U major_light = yellow]);
CTLSPEC NAME sequence_2 := AG (major_light = yellow -> AX major_light = red);
CTLSPEC NAME sequence_3 := AG (minor_light = green -> A[minor_light = green U minor_light = yellow]);

-- Propriétés du mode d'urgence
CTLSPEC NAME emergency_1 := AG (emergency_mode -> major_light = green);
CTLSPEC NAME emergency_2 := AG (emergency_mode -> minor_light = red);
CTLSPEC NAME emergency_3 := AG (emergency_mode -> ped_light = red);

-- Propriétés temporelles
CTLSPEC NAME temporal_1 := AG (major_light = green & timer_major = 30 & sensor = on -> AX major_light = yellow);
CTLSPEC NAME temporal_2 := AG (minor_light = green & timer_minor = 30 -> AX minor_light = yellow);
CTLSPEC NAME temporal_3 := AG (major_light = yellow & timer_yellow = 5 -> AX major_light = red);

-- Propriétés d'atteignabilité
CTLSPEC NAME reachability_1 := AG EF major_light = green;
CTLSPEC NAME reachability_2 := AG EF minor_light = green;
CTLSPEC NAME reachability_3 := AG EF ped_light = green;

-- Propriétés d'invariance
CTLSPEC NAME invariant_1 := AG (major_light = green -> timer_minor = 0);
CTLSPEC NAME invariant_2 := AG (minor_light = green -> timer_major = 0);
CTLSPEC NAME invariant_3 := AG (major_light = green | minor_light = green | major_light = yellow | minor_light = yellow);

-- how to excute the model :
-- ./NuSMV -int : Lancer NuSMV en mode interactif
-- NuSMV > read_model -i traffic_lights.smv : Charger le modèle
-- NuSMV > go : Construire le modèle
-- NuSMV > check_ctlspec -n 0 : Vérifier la propriété 
-- NuSMV > show_property : Affichez toutes les propriétés définies dans le modèle